+#ifndef GUARD_CONSTANTS_APOCRYPHA_H
+#define GUARD_CONSTANTS_APOCRYPHA_H
+
+// Campaign identifiers for the five-region / twenty-badge layout in DESIGN.md.
+// Data layer only. No maps, scripts, type-chart, HM gates, or obedience curve.
+
+#define NUM_REGIONS 5
+#define REGION_JOHTO  0
+#define REGION_KANTO  1
+#define REGION_HOENN  2
+#define REGION_SINNOH 3
+#define REGION_UNOVA  4
+
+// Vanilla NUM_BADGES stays 8 (trainer card tiles, contiguous FLAG_BADGE01..08 loops).
+// Sanctioned gyms are 20; the four unsanctioned Unova gyms award a TM, not a badge.
+#define NUM_SANCTIONED_BADGES 20
+#define REGION_BADGE_COUNT    4
+#define NUM_UNSANCTIONED_GYMS 4
+
+// Johto
+#define FLAG_BADGE_AZALEA     FLAG_BADGE01_GET // Bug, Turk
+#define FLAG_BADGE_ECRUTEAK   FLAG_BADGE02_GET // Psychic, Will
+#define FLAG_BADGE_BLACKTHORN FLAG_BADGE03_GET // Fairy, Valerie
+#define FLAG_BADGE_CIANWOOD   FLAG_BADGE04_GET // Rock, Shuckle Trainer
+// Kanto
+#define FLAG_BADGE_CERULEAN   FLAG_BADGE05_GET // Fire, Blaine
+#define FLAG_BADGE_FUCHSIA    FLAG_BADGE06_GET // Grass, Gardenia
+#define FLAG_BADGE_LAVENDER   FLAG_BADGE07_GET // Ghost, Eve
+#define FLAG_BADGE_VIRIDIAN   FLAG_BADGE08_GET // Terra, Paldean protagonist (final gym)
+// Hoenn
+#define FLAG_BADGE_RUSTBORO   FLAG_BADGE09_GET // Shadow, Wes
+#define FLAG_BADGE_SLATEPORT  FLAG_BADGE10_GET // Fighting, Brawly
+#define FLAG_BADGE_FORTREE    FLAG_BADGE11_GET // Flying, Falkner
+#define FLAG_BADGE_SOOTOPOLIS FLAG_BADGE12_GET // Dragon, Zinnia
+// Sinnoh
+#define FLAG_BADGE_JUBILIFE   FLAG_BADGE13_GET // Steel, Barry
+#define FLAG_BADGE_HEARTHOME  FLAG_BADGE14_GET // Dark, Darach
+#define FLAG_BADGE_PASTORIA   FLAG_BADGE15_GET // Poison, Saturn
+#define FLAG_BADGE_SUNYSHORE  FLAG_BADGE16_GET // Electric, Volkner
+// Unova (sanctioned)
+#define FLAG_BADGE_ASPERTIA   FLAG_BADGE17_GET // Normal, Cheren
+#define FLAG_BADGE_DRIFTVEIL  FLAG_BADGE18_GET // Ground, Clay
+#define FLAG_BADGE_ICIRRUS    FLAG_BADGE19_GET // Ice, Brycen
+#define FLAG_BADGE_HUMILAU    FLAG_BADGE20_GET // Water, Marlon
+
+// Unova unsanctioned gyms (TM reward, no badge). Flags live in flags.h.
+#define FLAG_UNSANCTIONED_VIRBANK  FLAG_UNSANCTIONED01 // Poison, Roxie
+#define FLAG_UNSANCTIONED_CASTELIA FLAG_UNSANCTIONED02 // Bug, Burgh
+#define FLAG_UNSANCTIONED_NIMBASA  FLAG_UNSANCTIONED03 // Electric, Elesa
+#define FLAG_UNSANCTIONED_OPELUCID FLAG_UNSANCTIONED04 // Dragon, Drayden
+
+#endif // GUARD_CONSTANTS_APOCRYPHA_H
