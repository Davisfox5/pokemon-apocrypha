+const u16 gSanctionedBadgeFlags[NUM_SANCTIONED_BADGES] =
+{
+    FLAG_BADGE_AZALEA,
+    FLAG_BADGE_ECRUTEAK,
+    FLAG_BADGE_BLACKTHORN,
+    FLAG_BADGE_CIANWOOD,
+    FLAG_BADGE_CERULEAN,
+    FLAG_BADGE_FUCHSIA,
+    FLAG_BADGE_LAVENDER,
+    FLAG_BADGE_VIRIDIAN,
+    FLAG_BADGE_RUSTBORO,
+    FLAG_BADGE_SLATEPORT,
+    FLAG_BADGE_FORTREE,
+    FLAG_BADGE_SOOTOPOLIS,
+    FLAG_BADGE_JUBILIFE,
+    FLAG_BADGE_HEARTHOME,
+    FLAG_BADGE_PASTORIA,
+    FLAG_BADGE_SUNYSHORE,
+    FLAG_BADGE_ASPERTIA,
+    FLAG_BADGE_DRIFTVEIL,
+    FLAG_BADGE_ICIRRUS,
+    FLAG_BADGE_HUMILAU,
+};
+
+// Johto is the starting region; its slot is 0 so RegionIsOpen always succeeds.
+const u16 gRegionAccessFlags[NUM_REGIONS] =
+{
+    0,
+    FLAG_SYS_REGION_KANTO_OPEN,
+    FLAG_SYS_REGION_HOENN_OPEN,
+    FLAG_SYS_REGION_SINNOH_OPEN,
+    FLAG_SYS_REGION_UNOVA_OPEN,
+};
+
+const u16 gUnsanctionedGymFlags[NUM_UNSANCTIONED_GYMS] =
+{
+    FLAG_UNSANCTIONED_VIRBANK,
+    FLAG_UNSANCTIONED_CASTELIA,
+    FLAG_UNSANCTIONED_NIMBASA,
+    FLAG_UNSANCTIONED_OPELUCID,
+};
+
+u32 CountSanctionedBadges(void)
+{
+    u32 i, n = 0;
+
+    for (i = 0; i < NUM_SANCTIONED_BADGES; i++)
+    {
+        if (FlagGet(gSanctionedBadgeFlags[i]))
+            n++;
+    }
+    return n;
+}
+
+u32 CountRegionBadges(u32 region)
+{
+    u32 i, n = 0;
+    u32 first;
+
+    if (region >= NUM_REGIONS)
+        return 0;
+    first = region * REGION_BADGE_COUNT;
+    for (i = 0; i < REGION_BADGE_COUNT; i++)
+    {
+        if (FlagGet(gSanctionedBadgeFlags[first + i]))
+            n++;
+    }
+    return n;
+}
+
+u32 CountUnsanctionedGyms(void)
+{
+    u32 i, n = 0;
+
+    for (i = 0; i < NUM_UNSANCTIONED_GYMS; i++)
+    {
+        if (FlagGet(gUnsanctionedGymFlags[i]))
+            n++;
+    }
+    return n;
+}
+
+u32 GetCurrentRegion(void)
+{
+    u16 region = VarGet(VAR_CURRENT_REGION);
+
+    if (region >= NUM_REGIONS)
+        return REGION_JOHTO;
+    return region;
+}
+
+bool8 SetCurrentRegion(u32 region)
+{
+    if (region >= NUM_REGIONS)
+        return FALSE;
+    if (!RegionIsOpen(region))
+        return FALSE;
+    return VarSet(VAR_CURRENT_REGION, region);
+}
+
+bool32 RegionIsOpen(u32 region)
+{
+    if (region >= NUM_REGIONS)
+        return FALSE;
+    if (gRegionAccessFlags[region] == 0)
+        return TRUE;
+    return FlagGet(gRegionAccessFlags[region]);
+}
+
+void UnlockRegion(u32 region)
+{
+    if (region >= NUM_REGIONS)
+        return;
+    if (gRegionAccessFlags[region] != 0)
+        FlagSet(gRegionAccessFlags[region]);
+}
