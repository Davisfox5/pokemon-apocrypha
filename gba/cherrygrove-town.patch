+CherrygroveMart_MapScripts::
+    .byte 0
+
+CherrygroveMart_Clerk::
+    lock
+    faceplayer
+    message gText_HowMayIServeYou
+    waitmessage
+    pokemart CherrygroveMart_Stock
+    msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
+    release
+    end
+
+    .align 2
