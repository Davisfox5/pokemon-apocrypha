  "rules": [
    "Reuse canonical transparent foreground masters; native palette indices may differ but preserve visible RGB.",
    "Reconstruct destination ground across the complete old object footprint; do not only apply an alpha mask.",
    "Pink T02 trees are exclusive to Cherrygrove.",
    "Use all sixteen G00-G15 tall-grass neighbor masks; preserve encounter behavior.",
    "Keep low Emerald jump ledges separate from R02 structural walls. Preserve jump direction.",
    "Use complete R02 rock/grass tiles and their orientation-specific corners, not separate grass slivers.",
    "Fit the gate opening, collision, warp, approach and surrounding tree layers together.",
    "City-specific houses, landmarks and different-height mountain/cave families stay local."
  ],
  "not_yet_standardized": [
    "Water and shoreline terrain families",
    "Regular ground and path transition families",
    "Mountain/cave caps and non-R02 cliff heights"
  ],
  "native_rollout": "gba/art/johto-common/rollout/README.md",
  "exceptions": [
    "Violet G02 gate replacement not installed: smallest exact candidate uses 1175 graphics against the 1008 limit. Existing Violet gates retained."
  ]
}
