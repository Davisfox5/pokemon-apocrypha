+    end
+
+CherrygroveCity_CompareSinnoh_Text::
+    .string "It is much warmer here than SINNOH.$"
+
+CherrygroveCity_CompareUnova::
+    lock
+    faceplayer
+    msgbox CherrygroveCity_CompareUnova_Text, MSGBOX_DEFAULT
