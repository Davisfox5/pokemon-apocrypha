     F(REST) \
-    F(DOUBLE_TEAM) \
     F(REFLECT) \
     F(LIGHT_SCREEN) \
     F(THUNDER_WAVE) \
@@ -43,15 +54,14 @@
     F(THUNDER_PUNCH) \
