diff --git a/data/maps/CherrygroveCity/scripts.inc b/data/maps/CherrygroveCity/scripts.inc
index fda633b7..489def95 100644
--- a/data/maps/CherrygroveCity/scripts.inc
+++ b/data/maps/CherrygroveCity/scripts.inc
@@ -1,51 +1,131 @@
 CherrygroveCity_MapScripts::
     .byte 0
 
-CherrygroveCity_Waterfront::
-    msgbox CherrygroveCity_Waterfront_Text, MSGBOX_NPC
-    end
-
-CherrygroveCity_Waterfront_Text:
-    .string "These boats do not go far anymore.\nNow they mostly just... sit.$"
-
-CherrygroveCity_Commuter::
-    msgbox CherrygroveCity_Commuter_Text, MSGBOX_NPC
-    end
-
-CherrygroveCity_Commuter_Text:
-    .string "Half the kids here ride to New Bark\nfor the labs now. Not Gold.\pHe came to Cherrygrove to get\naway from all that humming.$"
-
 CherrygroveCity_TownSign::
     msgbox CherrygroveCity_TownSign_Text, MSGBOX_NPC
     end
 
 CherrygroveCity_TownSign_Text:
-    .string "CHERRYGROVE CITY\nWhere the cherry trees and the sea\plook after their own.$"
+    .string "CHERRYGROVE CITY\nCity of fragrant flowers.$"
 
 CherrygroveCity_NorthSign::
     msgbox CherrygroveCity_NorthSign_Text, MSGBOX_NPC
     end
 
 CherrygroveCity_NorthSign_Text:
-    .string "ROUTE 30\nNorth toward VIOLET CITY$"
+    .string "ROUTE 30\nNorth to VIOLET CITY$"
 
 CherrygroveCity_EastSign::
     msgbox CherrygroveCity_EastSign_Text, MSGBOX_NPC
     end
 
 CherrygroveCity_EastSign_Text:
-    .string "ROUTE 29\nEast toward NEW BARK TOWN$"
+    .string "ROUTE 29\nEast to NEW BARK TOWN$"
 
 CherrygroveCity_GoldSign::
     msgbox CherrygroveCity_GoldSign_Text, MSGBOX_NPC
     end
 
 CherrygroveCity_GoldSign_Text:
-    .string "A quiet house and a worn battle yard.\nA man who has done enough.$"
+    .string "GOLD'S HOUSE$"
 
 CherrygroveCity_WaterfrontSign::
     msgbox CherrygroveCity_WaterfrontSign_Text, MSGBOX_NPC
     end
 
 CherrygroveCity_WaterfrontSign_Text:
-    .string "CHERRYGROVE WATERFRONT$"
+    .string "CHERRYGROVE PIER\nBoats moored here.$"
+
+CherrygroveCity_ParkSign::
+    msgbox CherrygroveCity_ParkSign_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_ParkSign_Text:
+    .string "BLOSSOM PARK\nPlease keep off the beds.$"
+
+CherrygroveCity_Gold::
+    msgbox CherrygroveCity_Gold_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Gold_Text:
+    .string "GOLD: SILVER came by to\nvisit. We had a battle.\pI lost. He says I have\ngotten rusty.\pThat is fine by me.\nIt was a good battle.$"
+
+CherrygroveCity_Silver::
+    lock
+    faceplayer
+    msgbox CherrygroveCity_Silver_Text, MSGBOX_DEFAULT
+    release
+    end
+
+CherrygroveCity_Silver_Text:
+    .string "SILVER is deep in conversation\nwith GOLD.\pHe does not seem to notice you.$"
+
+CherrygroveCity_Kestra::
+    msgbox CherrygroveCity_Kestra_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Kestra_Text:
+    .string "KESTRA: Did you see that?\nThat was SILVER!\pThe CHAMPION, right here\nin CHERRYGROVE!\pI want to battle like\nthat someday.$"
+
+CherrygroveCity_Woman::
+    msgbox CherrygroveCity_Woman_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Woman_Text:
+    .string "The boats hardly go out\nthese days.\pMy husband still mends the\nnets every morning.$"
+
+CherrygroveCity_Man::
+    msgbox CherrygroveCity_Man_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Man_Text:
+    .string "GOLD moved here for the\nquiet.\pWe see to it that he\ngets it.$"
+
+CherrygroveCity_Boy::
+    msgbox CherrygroveCity_Boy_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Boy_Text:
+    .string "The petals fall all\nthrough spring.\pMy mom says not to track\nthem into the house.$"
+
+CherrygroveCity_Girl::
+    msgbox CherrygroveCity_Girl_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Girl_Text:
+    .string "I walk the beach when the\ntide is out.\pYou can find shells if\nyou look.$"
+
+CherrygroveCity_Hoenn::
+    msgbox CherrygroveCity_Hoenn_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Hoenn_Text:
+    .string "I came from HOENN to see\nJOHTO.\pThe sea is colder here.\nThe sand is just as soft.$"
+
+CherrygroveCity_Kanto::
+    msgbox CherrygroveCity_Kanto_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Kanto_Text:
+    .string "I'm from KANTO. It's not so\nfar from here.\pThe towns are bigger there.\nI like it quiet here.$"
+
+CherrygroveCity_Johto::
+    msgbox CherrygroveCity_Johto_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Johto_Text:
+    .string "The POKEMON CENTER is here\nand the MART is next door.\pIt is a small town. Nothing\nis hard to find.$"
+
+CherrygroveCity_Sinnoh::
+    msgbox CherrygroveCity_Sinnoh_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Sinnoh_Text:
+    .string "Back home in SINNOH the sea\nis grey and the wind bites.\pI could stand on this pier\nall day.$"
+
+CherrygroveCity_Unova::
+    msgbox CherrygroveCity_Unova_Text, MSGBOX_NPC
+    end
+
+CherrygroveCity_Unova_Text:
+    .string "UNOVA has parks too, but\nnothing like this one.\pAll these trees are pink!$"
