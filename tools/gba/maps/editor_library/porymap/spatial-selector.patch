 void MetatileSelector::updateBasePixmap() {
+    if (!defaultSelectorWidth) defaultSelectorWidth = numMetatilesWide;
+    numMetatilesWide = defaultSelectorWidth;
+    organizedTiles.clear();
+    organizedPositions.clear();
+    // This is display order only. Native IDs, maps, animations and scripts stay intact.
+    QFile file(projectConfig.projectDir() + "/porymap.selector.json");
+    if (layout && file.open(QIODevice::ReadOnly)) {
+        const auto root = QJsonDocument::fromJson(file.readAll()).object();
+        const auto spec = root.value("layouts").toObject().value(layout->id).toObject();
+        const int width = spec.value("width").toInt();
+        const auto cells = spec.value("cells").toArray();
+        bool valid = root.value("version").toInt() == 1 && width >= 4 && width <= 32
+            && !cells.isEmpty() && cells.size() <= 32768 && cells.size() % width == 0
+            && spec.value("primary").toString() == layout->tileset_primary_label
+            && spec.value("secondary").toString() == layout->tileset_secondary_label;
+        // A catalog for another native revision must never point at the wrong art.
+        const auto hashes = spec.value("sources").toObject();
+        if (hashes.isEmpty()) valid = false;
+        for (auto it = hashes.begin(); valid && it != hashes.end(); ++it) {
+            QFile source(projectConfig.projectDir() + "/" + it.key());
+            valid = source.open(QIODevice::ReadOnly) &&
+                QCryptographicHash::hash(source.readAll(), QCryptographicHash::Sha256).toHex()
+                    == it.value().toString().toLatin1();
+        }
+        for (const auto &cell : cells) {
+            const int id = cell.toInt(-1);
+            if (id < -1 || (id >= 0 && (id > 1023 || !layout->metatileIsValid(id)))) valid = false;
+        }
+        if (valid) {
+            numMetatilesWide = width;
+            QImage image(width * 16, cells.size() / width * 16, QImage::Format_ARGB32);
+            image.fill(QColor(38, 44, 50));
+            QPainter painter(&image);
+            for (int i = 0; i < cells.size(); ++i) {
+                const int id = cells[i].toInt(-1);
+                organizedTiles.append(id);
+                if (id < 0) continue;
+                const QPoint pos(i % width, i / width);
+                if (!organizedPositions.contains(id)) organizedPositions.insert(id, pos);
+                painter.drawImage(pos * 16, getMetatileImage(id, layout));
+            }
+            QFont font = painter.font(); font.setPixelSize(10); painter.setFont(font);
+            for (const auto &value : spec.value("headings").toArray()) {
+                auto header = value.toObject(); int row = header.value("row").toInt(-1);
+                if (row < 0 || row >= cells.size() / width) continue;
+                painter.fillRect(0, row * 16, width * 16, 16, QColor(55, 71, 81));
+                painter.setPen(QColor(235, 243, 247));
+                painter.drawText(QRect(4, row * 16, width * 16 - 8, 16), Qt::AlignVCenter,
+                                 header.value("title").toString());
+            }
+            for (const auto &value : spec.value("labels").toArray()) {
+                auto label = value.toObject();
+                QRect rect(label.value("column").toInt() * 16 + 1,
+                           label.value("row").toInt() * 16, label.value("width").toInt() * 16 - 2, 16);
+                painter.setPen(QColor(183, 216, 232));
+                painter.drawText(rect, Qt::AlignVCenter,
+                    QFontMetrics(font).elidedText(label.value("title").toString(), Qt::ElideRight, rect.width()));
+            }
+            painter.end();
+            basePixmap = QPixmap::fromImage(image);
+            return;
+        }
+    }
     this->basePixmap = QPixmap::fromImage(getMetatileSheetImage(this->layout, this->numMetatilesWide));
 }
 
